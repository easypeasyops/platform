// Renovate bumps the pins Dependabot can't read (dependabot.yaml has the rest): it opens a PR
// when one of them has a new release, and CI decides whether it's safe to merge.
//
// Only the regex managers below run. Renovate's own managers stay off, so the pinned
// GitHub Actions keep one bumper (Dependabot), not two.
//
// Upstream bumps never merge on their own: a chart bump reaches the cluster, prod included,
// on merge, so a person reads the upstream release notes first. A chart's comment in
// values.yaml names the app version it ships (e.g. "Argo Rollouts v1.10.0"); Renovate can't
// see that, so update it in the bump PR. Their minor and patch updates come in one PR a
// week, together.
//
// A major update, upstream or an app's pin, opens no PR until a person ticks it on the
// Dependency Dashboard: it can break things, so someone decides when to take it on.
//
// The apps' service chart pins (apps/<app>/envs/<env>.yaml) move on their own, one PR per
// env file, never grouped, so staging and prod stay apart. A new service/vX.Y.Z release
// opens a PR for every non-prod env (staging, ops) that auto-merges once CI, check-apps.py
// included, is green; a major version waits for a person, since an app must react to it. Prod follows the app's staging pin on main, so its
// PR opens only once staging runs that version, and it never auto-merges: Emrah merges it.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "schedule:weekly"],
  enabledManagers: ["custom.regex"],
  customManagers: [
    {
      // The upstream charts the platform chart pins: version and digest move together.
      // An OCI chart is read through the docker datasource; its digest is the manifest's,
      // the one tests/test_platform.py checks the version still resolves to.
      customType: "regex",
      managerFilePatterns: ["/^deploy/argocd/platform/values\\.yaml$/"],
      matchStrings: [
        "repo: oci://(?<depName>\\S+)\\n\\s+version: (?<currentValue>\\S+)\\n\\s+digest: (?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      datasourceTemplate: "docker",
    },
    {
      // The tool images ci.yml runs with `docker run`.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/ci\\.yml$/"],
      matchStrings: [
        "(?<depName>ghcr\\.io/yannh/kubeconform|rhysd/actionlint):(?<currentValue>[\\w.-]+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      // An app's pins, version and digest together; depName is the app and depType the env,
      // so each env file gets its own PR. Non-prod (staging, ops) follows the service chart's
      // releases on GHCR (the digest is the one the release notes give); prod follows its
      // staging pin on main (custom.staging-pin). One manager, picking by env: Renovate's
      // RE2 regexes have no lookahead, so a file pattern can't say "every env but prod".
      customType: "regex",
      managerFilePatterns: ["/^apps/[^/]+/envs/[^/]+\\.yaml$/"],
      matchStrings: [
        "app: (?<depName>\\S+)\\nenv: (?<depType>\\S+)\\n[\\s\\S]*?chart:\\n\\s+version: (?<currentValue>\\S+)\\n\\s+digest: (?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      packageNameTemplate: "{{#if (equals depType 'prod')}}{{{depName}}}{{else}}ghcr.io/easypeasyops/charts/service{{/if}}",
      datasourceTemplate: "{{#if (equals depType 'prod')}}custom.staging-pin{{else}}docker{{/if}}",
      versioningTemplate: "semver", // skips the sha256-… attestation tags
    },
  ],
  customDatasources: {
    // The one release an app's prod may move to: its staging env file on main.
    "staging-pin": {
      defaultRegistryUrlTemplate: "https://raw.githubusercontent.com/easypeasyops/platform/main/apps/{{packageName}}/envs/staging.yaml",
      format: "yaml",
      transformTemplates: [
        '{"releases": [{"version": chart.version, "digest": chart.digest}]}',
      ],
    },
  },
  packageRules: [
    {
      // The apps' pins: checked whenever Renovate runs, not weekly; staging and ops auto-merge.
      matchFileNames: ["apps/*/envs/*.yaml"],
      schedule: ["at any time"],
      branchTopic: "service-chart-{{{depName}}}-{{{depType}}}",
      commitMessageTopic: "service chart for {{{depName}}} {{{depType}}}",
      automerge: true,
      automergeStrategy: "squash",
    },
    {
      matchFileNames: ["apps/*/envs/*.yaml"],
      matchUpdateTypes: ["major"],
      automerge: false,
    },
    {
      matchFileNames: ["apps/*/envs/prod.yaml"],
      automerge: false,
    },
    {
      // The upstream charts and the tool images: minor and patch updates in one PR.
      matchFileNames: ["deploy/argocd/platform/values.yaml", ".github/workflows/ci.yml"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "upstream minor and patch",
    },
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      // Envoy Gateway pushes every release under two tags (v1.9.2 and 1.9.2): stay on the v one.
      matchPackageNames: ["registry-1.docker.io/envoyproxy/gateway-helm"],
      allowedVersions: "/^v/",
    },
  ],
}

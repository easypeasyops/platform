{
  "apiVersion": "monitoring.coreos.com/v1",
  "kind": "PodMonitorList",
  "items": [
    {
      "apiVersion": "monitoring.coreos.com/v1",
      "kind": "PodMonitor",
      "metadata": {
        "name": "cloudnative-pg",
        "namespace": "argocd"
      },
      "spec": {
        "jobLabel": "app.kubernetes.io/name",
        "namespaceSelector": {
          "matchNames": [
            "cnpg-system"
          ]
        },
        "podMetricsEndpoints": [
          {
            "interval": "60s",
            "port": "metrics"
          }
        ],
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "cloudnative-pg"
          }
        }
      }
    }
  ]
}

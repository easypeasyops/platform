            "port": "http-web"
          },
          {
            "path": "/metrics",
            "port": "reloader-web"
          }
        ],
        "namespaceSelector": {
          "matchNames": [
            "monitoring"
          ]
        },
        "selector": {
          "matchLabels": {
            "app": "kube-prometheus-stack-prometheus",
            "release": "monitoring",
            "self-monitor": "true"
          }
        }
      }
    },
    {

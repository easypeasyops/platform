{
  "apiVersion": "monitoring.coreos.com/v1",
  "kind": "ServiceMonitorList",
  "items": [
    {
      "apiVersion": "monitoring.coreos.com/v1",
      "kind": "ServiceMonitor",
      "metadata": {
        "name": "aipostit",
        "namespace": "aipostit-prod"
      },
      "spec": {
        "endpoints": [
          {
            "interval": "15s",
            "path": "/metrics",
            "port": "metrics"
          }
        ],
        "podTargetLabels": [
          "rollouts-pod-template-hash"
        ],
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/instance": "aipostit",
            "app.kubernetes.io/name": "aipostit"
          }
        }
      }
    },
    {
      "apiVersion": "monitoring.coreos.com/v1",
      "kind": "ServiceMonitor",
      "metadata": {
        "name": "kyverno",
        "namespace": "argocd"
      },
      "spec": {
        "endpoints": [
          {
            "interval": "30s",
            "port": "metrics-port"
          }
        ],
        "namespaceSelector": {
          "matchNames": [
            "kyverno"
          ]
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/instance": "kyverno",
            "app.kubernetes.io/part-of": "kyverno"
          }
        }
      }
    },
    {
      "apiVersion": "monitoring.coreos.com/v1",
      "kind": "ServiceMonitor",
      "metadata": {
        "name": "kps-alertmanager",
        "namespace": "monitoring"
      },
      "spec": {
        "endpoints": [
          {
            "enableHttp2": true,
            "path": "/metrics",
            "port": "http-web"
          },
          {
            "path": "/metrics",
            "port": "reloader-web"
          }
        ],
        "namespaceSelector": {
          "matchNames": [
            "monitoring"
          ]
        },
        "selector": {
          "matchLabels": {
            "app": "kube-prometheus-stack-alertmanager",
            "release": "monitoring",
            "self-monitor": "true"
          }
        }
      }
    }
  ]
}
